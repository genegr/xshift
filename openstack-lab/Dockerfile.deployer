# kolla-ansible deployer image (runs on the dev/jump box, deploys OpenStack to
# openstack00 over SSH). Build: docker build -t kolla-deployer:2026.1 -f Dockerfile.deployer .
FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive \
    ANSIBLE_HOST_KEY_CHECKING=False \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      openssh-client sshpass git ca-certificates iputils-ping \
 && rm -rf /var/lib/apt/lists/*

# kolla-ansible pulls a compatible ansible-core; openstackclient for verification
RUN pip install "kolla-ansible==22.0.0" python-openstackclient

# Bake kolla ansible-galaxy collection deps into the image
RUN kolla-ansible install-deps

WORKDIR /config
CMD ["bash"]
